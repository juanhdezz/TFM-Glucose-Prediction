\newlabel{fig:dist_rmse_oversampling}{{5.24}{90}{Distribución del RMSE (\textit {ENTIRE}) para la familia \textit {oversampling} (Jittering, ROS, SMOTE, ROS+Tomek). Las técnicas de esta familia incrementan el volumen del conjunto de entrenamiento respecto a la partición original}{figure.caption.138}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.25}{\ignorespaces Distribución del RMSE (\textit  {ENTIRE}) para la familia \textit  {same size} (RUS+ROS, RUS+SMOTE, SMOTE+Tomek). Estas técnicas híbridas mantienen el volumen de entrenamiento constante, actuando como grupo de control natural.}}{91}{figure.caption.139}\protected@file@percent }
\newlabel{fig:dist_rmse_samesize}{{5.25}{91}{Distribución del RMSE (\textit {ENTIRE}) para la familia \textit {same size} (RUS+ROS, RUS+SMOTE, SMOTE+Tomek). Estas técnicas híbridas mantienen el volumen de entrenamiento constante, actuando como grupo de control natural}{figure.caption.139}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.26}{\ignorespaces Distribución del RMSE (\textit  {ENTIRE}) para la familia \textit  {undersampling} (RUS, PA-Undersampling, Tomek Links). Las técnicas de esta familia reducen el volumen del conjunto de entrenamiento eliminando ventanas del grupo mayoritario.}}{91}{figure.caption.140}\protected@file@percent }
\newlabel{fig:dist_rmse_undersampling}{{5.26}{91}{Distribución del RMSE (\textit {ENTIRE}) para la familia \textit {undersampling} (RUS, PA-Undersampling, Tomek Links). Las técnicas de esta familia reducen el volumen del conjunto de entrenamiento eliminando ventanas del grupo mayoritario}{figure.caption.140}{}}
