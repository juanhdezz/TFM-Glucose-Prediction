\@writefile{toc}{\contentsline {paragraph}{Resultado global del test de Friedman.}{94}{section*.146}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces Resumen del test de Friedman por \textit  {dataset} y rango glucémico (métrica RMSE). Se indica el estadístico $\chi ^2_F$, el $p$-valor y si el test es significativo ($\alpha = 0{,}05$). Un asterisco (*) señala significación.}}{95}{table.caption.147}\protected@file@percent }
\newlabel{tab:friedman_resumen}{{5.1}{95}{Resumen del test de Friedman por \textit {dataset} y rango glucémico (métrica RMSE). Se indica el estadístico $\chi ^2_F$, el $p$-valor y si el test es significativo ($\alpha = 0{,}05$). Un asterisco (*) señala significación}{table.caption.147}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.30}{\ignorespaces Diagramas de diferencia crítica (Nemenyi post-hoc) para el RMSE sobre el conjunto completo (\textit  {ENTIRE}). Las técnicas se ordenan por rango medio (menor a la izquierda = mejor). Técnicas conectadas por una barra horizontal no difieren significativamente ($\alpha = 0{,}05$, $\text  {CD} = 13{,}25$). El test de Friedman previo solo es significativo en DiaTrend ($p < 0{,}0001$).}}{95}{figure.caption.148}\protected@file@percent }
\newlabel{fig:cd_rmse_entire}{{5.30}{95}{Diagramas de diferencia crítica (Nemenyi post-hoc) para el RMSE sobre el conjunto completo (\textit {ENTIRE}). Las técnicas se ordenan por rango medio (menor a la izquierda = mejor). Técnicas conectadas por una barra horizontal no difieren significativamente ($\alpha = 0{,}05$, $\text {CD} = 13{,}25$). El test de Friedman previo solo es significativo en DiaTrend ($p < 0{,}0001$)}{figure.caption.148}{}}
\@writefile{toc}{\contentsline {paragraph}{CD diagrams ENTIRE: significación global.}{95}{section*.149}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.31}{\ignorespaces Diagramas de diferencia crítica (Nemenyi) para el RMSE evaluado exclusivamente en el rango TBR-2 (hipoglucemia severa, $<$54\,mg/dL). El test de Friedman es significativo únicamente en DiaTrend ($p = 0{,}00013$); en T1DiabetesGranada ($p = 0{,}437$) y REPLACE-BG ($p = 0{,}779$) no lo es.}}{96}{figure.caption.150}\protected@file@percent }
\newlabel{fig:cd_rmse_tbr2}{{5.31}{96}{Diagramas de diferencia crítica (Nemenyi) para el RMSE evaluado exclusivamente en el rango TBR-2 (hipoglucemia severa, $<$54\,mg/dL). El test de Friedman es significativo únicamente en DiaTrend ($p = 0{,}00013$); en T1DiabetesGranada ($p = 0{,}437$) y REPLACE-BG ($p = 0{,}779$) no lo es}{figure.caption.150}{}}
\@writefile{toc}{\contentsline {paragraph}{CD diagrams TBR-2: significación en hipoglucemia severa.}{96}{section*.151}\protected@file@percent }
