\@writefile{toc}{\contentsline {paragraph}{El balanceo demográfico no mejora el rendimiento global de forma generalizable.}{103}{section*.165}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Existe un trade-off estructural entre rendimiento global y sensibilidad a hipoglucemia severa.}{103}{section*.166}\protected@file@percent }
