\@writefile{lof}{\contentsline {figure}{\numberline {5.28}{\ignorespaces Perfil de RMSE por rango glucémico para la familia \textit  {same size}. El perfil intermedio de estas técnicas híbridas permite cuantificar en qué medida la fase de submuestreo cancela los beneficios de la fase de sobremuestreo.}}{93}{figure.caption.143}\protected@file@percent }
