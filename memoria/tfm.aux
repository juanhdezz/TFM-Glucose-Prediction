\@writefile{toc}{\contentsline {paragraph}{El balanceo demográfico no mejora el rendimiento global de forma generalizable.}{103}{section*.161}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Existe un trade-off estructural entre rendimiento global y sensibilidad a hipoglucemia severa.}{103}{section*.162}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{El efecto del balanceo es dataset-dependiente y explicable por propiedades estructurales.}{103}{section*.163}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{El balanceo por edad supera al balanceo por sexo en magnitud de efecto.}{104}{section*.164}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Tomek Links es la técnica con mejor relación beneficio/coste en el repositorio más complejo.}{104}{section*.165}\protected@file@percent }
