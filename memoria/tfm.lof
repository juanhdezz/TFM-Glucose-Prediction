\contentsline {figure}{\numberline {4.1}{\ignorespaces Visión general del flujo de trabajo del proyecto RELIEF-T1D.}}{26}{figure.caption.17}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Distribución de pacientes por grupo de edad ($<$31, 31--45, 46--65, $\geq $66) en cada \textit {dataset}.}}{31}{figure.caption.33}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Distribución por sexo (izquierda) e interacción edad~$\times $~sexo (derecha). Cada celda del \textit {heatmap} indica el número de pacientes en esa combinación demográfica.}}{32}{figure.caption.35}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Distribución de los valores de glucosa (mg/dL) por grupo de edad en cada \textit {dataset}. Las líneas horizontales internas indican la mediana; los límites del violín, el rango intercuartílico (IQR). Las líneas discontinuas indican los umbrales de hipoglucemia (70\,mg/dL) e hiperglucemia (180\,mg/dL).}}{33}{figure.caption.38}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Porcentaje de mediciones en cada rango glucémico (TBR, TIR, TAR) desagregado por sexo y \textit {dataset}.}}{34}{figure.caption.41}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Distribución de mediciones por rango glucémico (TBR-2, TBR-1, TIR, TAR-1, TAR-2) según grupo de edad, por \textit {dataset}.}}{34}{figure.caption.42}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Número de mediciones por paciente desagregado por grupo de edad y \textit {dataset}. La gran dispersión inter-paciente refleja la heterogeneidad en la duración efectiva del seguimiento y en la adherencia al sensor.}}{35}{figure.caption.44}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Duración del seguimiento (en días) por grupo de edad y \textit {dataset}.}}{35}{figure.caption.45}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Glucemia media por grupo de edad y \textit {dataset}. Las barras de error representan la desviación típica inter-paciente dentro de cada grupo.}}{37}{figure.caption.49}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Variabilidad glucémica intra-grupo por dimensión demográfica y \textit {dataset}.}}{37}{figure.caption.50}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Distribución porcentual de ventanas de entrenamiento por clase glucémica (hipoglucemia $<$70\,mg/dL, normoglucemia 70--180\,mg/dL, hiperglucemia $>$180\,mg/dL) y grupo de edad en cada \textit {dataset} (horizonte PH\,=\,4, fold de referencia). Los porcentajes permiten comparar el desequilibrio glucémico entre grupos de edad y con la figura~\ref {fig:age_group_dist}.}}{40}{figure.caption.56}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces Ratio de desequilibrio glucémico (ventanas normoglucémicas / ventanas hipoglucémicas) por grupo de edad y \textit {dataset}, expresado como mediana $\pm $ IQR entre pacientes del fold de referencia. Un ratio de 1{,}0 indicaría distribución perfectamente equilibrada entre ambas clases.}}{41}{figure.caption.57}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Distribución porcentual de ventanas de entrenamiento por clase glucémica y sexo en cada \textit {dataset}. La similitud entre grupos sugiere que el sexo no introduce desequilibrio glucémico diferencial.}}{42}{figure.caption.58}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Arquitectura del modelo LSTM.}}{53}{figure.caption.78}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Clark Error Grid de una ejecucion de LSTM para el dataset T1DiabetesGranada.}}{55}{figure.caption.80}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Tamaño medio del conjunto de entrenamiento (número de ventanas, media $\pm $ SD sobre los 5 \textit {folds}) por técnica de balanceo y \textit {dataset}, para la dimensión demográfica \textbf {edad}. La línea discontinua indica el tamaño medio del conjunto original sin balancear.}}{64}{figure.caption.91}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Tamaño medio del conjunto de entrenamiento por técnica de balanceo y \textit {dataset}, para la dimensión demográfica \textbf {sexo}. Misma escala relativa y convenciones que la figura~\ref {fig:trainsize_age}.}}{65}{figure.caption.95}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Variación $\Delta n$ y $\Delta \%$ de ventanas por técnica de balanceo y grupo de edad en \textbf {T1DiabetesGranada}. Escala de color unificada con las figuras~\ref {fig:heatmap_age_diatrend} y~\ref {fig:heatmap_age_replacbg}. Las filas corresponden a las diez técnicas evaluadas; las columnas, a los grupos de edad ($<$31, 31--45, 46--65, $\geq $66).}}{66}{figure.caption.97}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Variación $\Delta n$ y $\Delta \%$ de ventanas por técnica de balanceo y grupo de edad en \textbf {DiaTrend}. La escala de color es la misma que en la figura~\ref {fig:heatmap_age_t1d}; la saturación visiblemente superior en este \textit {dataset} refleja el desequilibrio demográfico extremo documentado en la sección~\ref {subsec:eda_demografico}.}}{67}{figure.caption.98}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Variación $\Delta n$ y $\Delta \%$ de ventanas por técnica de balanceo y grupo de edad en \textbf {REPLACE-BG}. La menor saturación respecto a DiaTrend (figura~\ref {fig:heatmap_age_diatrend}), con escala idéntica, confirma que el diseño controlado del estudio ---con seguimientos homogéneos de $\approx $182 días para todos los grupos--- limita la amplificación del desequilibrio demográfico al pasar de paciente a ventana.}}{68}{figure.caption.99}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Distribución de ventanas por rango glucémico en el conjunto de entrenamiento de \textbf {T1DiabetesGranada}, por técnica de balanceo y dimensión demográfica. Cada barra representa la media sobre los 5 \textit {folds}. La barra con borde grueso es la condición original de referencia.}}{70}{figure.caption.101}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Variación $\Delta \%$ en la representación de cada rango glucémico para \textbf {T1DiabetesGranada} tras aplicar cada técnica, respecto al conjunto original. Barras divergentes: positivo = mayor representación del rango; negativo = menor. Promediado sobre \textit {folds} y clases demográficas.}}{71}{figure.caption.102}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Distribución glucémica del conjunto de entrenamiento de \textbf {DiaTrend} por técnica y dimensión. Las barras de ROS, SMOTE y Jittering alcanzan valores absolutos muy superiores al resto como consecuencia del ratio de desequilibrio extremo de este \textit {dataset}.}}{72}{figure.caption.104}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Variación $\Delta \%$ en la representación de rangos glucémicos para \textbf {DiaTrend}. La escala del eje es comparable a la de T1DiabetesGranada y REPLACE-BG; la magnitud de los cambios es notablemente superior en este \textit {dataset}.}}{73}{figure.caption.105}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Distribución glucémica del conjunto de entrenamiento de \textbf {REPLACE-BG} por técnica y dimensión. La homogeneidad de los seguimientos produce barras visualmente más uniformes entre técnicas que en los otros dos repositorios.}}{74}{figure.caption.107}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Variación $\Delta \%$ en la representación de rangos glucémicos para \textbf {REPLACE-BG}. Los cambios son los más moderados de los tres \textit {datasets}, confirmando que la homogeneidad de los seguimientos limita el impacto glucémico del balanceo demográfico.}}{75}{figure.caption.108}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Trade-off clínico entre la variación de hipoglucemia severa ($\Delta \%$ TBR-2, eje $X$) y la variación de normoglucemia ($\Delta \%$ TIR, eje $Y$) tras aplicar cada técnica de balanceo, por \textit {dataset}. Cada punto representa una técnica $\times $ dimensión demográfica ($\circ $\,=\,edad, $\square $\,=\,sexo). El cuadrante superior izquierdo (``ideal'') corresponde a técnicas que aumentan TIR sin incrementar la exposición a hipoglucemia severa.}}{76}{figure.caption.111}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Trade-off clínico entre la variación de hipoglucemia leve ($\Delta \%$ TBR-1, eje $X$) y la variación de normoglucemia ($\Delta \%$ TIR, eje $Y$). Mismas convenciones que la figura~\ref {fig:tradeoff_tbr2}.}}{77}{figure.caption.113}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Trade-off clínico entre la variación de hiperglucemia leve ($\Delta \%$ TAR-1, eje $X$) y la variación de normoglucemia ($\Delta \%$ TIR, eje $Y$). En este scatter el cuadrante ideal (superior izquierdo) corresponde a técnicas que aumentan TIR reduciendo simultáneamente la exposición a hiperglucemia leve.}}{78}{figure.caption.115}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Trade-off clínico entre la variación de hiperglucemia severa ($\Delta \%$ TAR-2, eje $X$) y la variación de normoglucemia ($\Delta \%$ TIR, eje $Y$). El cuadrante ideal (superior izquierdo) corresponde a técnicas que incrementan TIR reduciendo la exposición a hiperglucemia severa.}}{79}{figure.caption.117}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Distribución del RMSE sobre el conjunto completo de ventanas (\textit {ENTIRE}) por técnica de balanceo y \textit {dataset}. Cada violín resume la distribución entre los 5 \textit {folds}; la línea discontinua interior indica la mediana y las líneas externas el rango intercuartílico. La condición \textit {original} (negro) aparece como referencia.}}{80}{figure.caption.119}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Distribución del RMSE evaluado exclusivamente sobre ventanas del rango TBR-2 (hipoglucemia severa, $<$54\,mg/dL) por técnica de balanceo y \textit {dataset}. Este subconjunto es el más relevante clínicamente: un modelo con buen rendimiento global pero alto error en TBR-2 puede ser clínicamente inaceptable.}}{81}{figure.caption.121}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Consistencia del ranking de técnicas entre \textit {folds}, medida mediante la correlación de Spearman entre los rankings de RMSE (ENTIRE) de cada par de folds, por \textit {dataset}. Valores próximos a 1 indican que el mismo ranking de técnicas se reproduce en todos los folds; valores próximos a 0 o negativos indican inestabilidad: la técnica que es mejor en un fold puede ser peor en otro.}}{82}{figure.caption.123}%
\contentsline {figure}{\numberline {5.19}{\ignorespaces Variación relativa del RMSE (\textit {ENTIRE}) respecto al modelo original para cada técnica y \textit {dataset}. Valores positivos (azul) indican mejora; valores negativos (naranja) indican deterioro. Escala de color centrada en cero.}}{84}{figure.caption.125}%
\contentsline {figure}{\numberline {5.20}{\ignorespaces Variación relativa del RMSE evaluado sobre ventanas TBR-2 (hipoglucemia severa) respecto al modelo original. Compárese con la figura~\ref {fig:heatmap_delta_rmse_entire}: una técnica con celda azul en la figura anterior pero naranja en esta produce una mejora global a costa de mayor imprecisión en el rango más crítico clínicamente.}}{86}{figure.caption.127}%
\contentsline {figure}{\numberline {5.21}{\ignorespaces Posición en el ranking de cada técnica por RMSE, para cada combinación \textit {dataset} $\times $ rango glucémico (ranking 1 = menor RMSE = mejor). Las celdas verdes indican posiciones altas del ranking; las naranjas, posiciones bajas.}}{88}{figure.caption.129}%
\contentsline {figure}{\numberline {5.22}{\ignorespaces \textit {Dumbbell chart} comparando el RMSE (\textit {ENTIRE}) del modelo original (rombo negro) frente a cada técnica balanceada (círculo de color), ordenadas de mejor a peor por \textit {dataset}. Las barras de error indican la SD inter-fold.}}{89}{figure.caption.131}%
\contentsline {figure}{\numberline {5.23}{\ignorespaces Gráfico de pendiente del RMSE (\textit {ENTIRE}) comparando el modelo original con cada técnica, separado por dimensión demográfica (edad vs.\ sexo). Una pendiente negativa indica mejora. Los tres repositorios aparecen superpuestos en cada panel; los grupos de líneas bien separados por nivel corresponden a los tres \textit {datasets}.}}{90}{figure.caption.133}%
\contentsline {figure}{\numberline {5.24}{\ignorespaces Distribución del RMSE (\textit {ENTIRE}) por familia de tamaño: técnicas que incrementan el conjunto de entrenamiento (\textit {oversampling}), que lo mantienen constante (\textit {same size}) y que lo reducen (\textit {undersampling}). La comparación entre los tres paneles permite separar el efecto del volumen de datos del efecto del reequilibrio demográfico.}}{91}{figure.caption.135}%
\contentsline {figure}{\numberline {5.25}{\ignorespaces Perfil de RMSE por rango glucémico y familia de tamaño. Cada panel muestra el RMSE medio sobre los \textit {folds} para cada rango glucémico (TBR\_2, TBR\_1, TIR, TAR\_1, TAR\_2) y \textit {dataset}. El perfil revela si el efecto del balanceo es uniforme entre rangos o si hay rangos que se benefician (o perjudican) selectivamente.}}{91}{figure.caption.136}%
\contentsline {figure}{\numberline {5.26}{\ignorespaces Diagramas de diferencia crítica (Nemenyi post-hoc) para el RMSE sobre el conjunto completo (\textit {ENTIRE}). Las técnicas se ordenan por rango medio (menor a la izquierda = mejor rendimiento). Técnicas conectadas por una barra horizontal no difieren significativamente ($\alpha = 0{,}05$). El test de Friedman previo se rechaza si el $p$-valor es inferior al nivel de significación.}}{92}{figure.caption.137}%
\contentsline {figure}{\numberline {5.27}{\ignorespaces Diagramas de diferencia crítica (Nemenyi) para el RMSE evaluado exclusivamente en el rango TBR\_2 (hipoglucemia severa). Compárese con la figura~\ref {fig:cd_rmse_entire}: ¿el orden de las técnicas cambia cuando se focaliza la evaluación en el rango clínicamente más crítico?}}{92}{figure.caption.138}%
\contentsline {figure}{\numberline {5.28}{\ignorespaces Ranking global de técnicas de balanceo mediante el método Borda (suma de rangos a través de \textit {datasets}, métricas y rangos glucémicos). Una técnica con Borda más alto ocupa posiciones superiores del ranking de forma más consistente entre todos los escenarios evaluados. El gráfico \textit {lollipop} facilita la comparación de la puntuación acumulada.}}{93}{figure.caption.139}%
\contentsline {figure}{\numberline {5.29}{\ignorespaces \textit {Bump chart} mostrando la evolución del ranking de cada técnica entre los tres \textit {datasets} para el RMSE en el conjunto completo (\textit {ENTIRE}). Técnicas con líneas horizontales mantienen su posición relativa entre datasets (comportamiento estable); técnicas con líneas muy inclinadas cambian de posición (comportamiento dataset-dependiente).}}{93}{figure.caption.140}%
