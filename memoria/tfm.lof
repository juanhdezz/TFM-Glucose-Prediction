\contentsline {figure}{\numberline {4.1}{\ignorespaces Visión general del flujo de trabajo del TFM.}}{26}{figure.caption.17}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Distribución de pacientes por grupo de edad ($<$31, 31--45, 46--65, $\geq $66) en cada \textit {dataset}.}}{31}{figure.caption.33}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Distribución por sexo en cada \textit {dataset}.}}{32}{figure.caption.35}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces \textit {Heatmap} de la distribución conjunta edad~$\times $~sexo por \textit {dataset}. Cada celda indica el número de pacientes en esa combinación demográfica.}}{32}{figure.caption.36}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Distribución de los valores de glucosa (mg/dL) por grupo de edad en cada \textit {dataset}. Las líneas horizontales internas indican la mediana; los límites del violín, el rango intercuartílico (IQR). Las líneas discontinuas indican los umbrales de hipoglucemia (70\,mg/dL) e hiperglucemia (180\,mg/dL).}}{33}{figure.caption.39}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Porcentaje de mediciones en cada rango glucémico (TBR, TIR, TAR) desagregado por sexo y \textit {dataset}.}}{34}{figure.caption.42}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Distribución de mediciones por rango glucémico (TBR-2, TBR-1, TIR, TAR-1, TAR-2) según grupo de edad, por \textit {dataset}.}}{34}{figure.caption.43}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Número de mediciones por paciente desagregado por grupo de edad y \textit {dataset}. La gran dispersión inter-paciente refleja la heterogeneidad en la duración efectiva del seguimiento y en la adherencia al sensor.}}{35}{figure.caption.45}%
\contentsline {figure}{\numberline {4.9}{\ignorespaces Duración del seguimiento (en días) por grupo de edad y \textit {dataset}.}}{36}{figure.caption.46}%
\contentsline {figure}{\numberline {4.10}{\ignorespaces Glucemia media por grupo de edad y \textit {dataset}. Las barras de error representan la desviación típica inter-paciente dentro de cada grupo.}}{37}{figure.caption.50}%
\contentsline {figure}{\numberline {4.11}{\ignorespaces Coeficiente de variación glucémico por grupo de edad y \textit {dataset}. La línea discontinua roja indica el umbral CV$=36\%$ recomendado como indicador de variabilidad elevada.}}{38}{figure.caption.51}%
\contentsline {figure}{\numberline {4.12}{\ignorespaces Coeficiente de variación glucémico por sexo y \textit {dataset}. La línea discontinua roja indica el umbral CV$=36\%$ recomendado como indicador de variabilidad elevada.}}{38}{figure.caption.53}%
\contentsline {figure}{\numberline {4.13}{\ignorespaces Distribución porcentual de ventanas de entrenamiento por clase glucémica (hipoglucemia $<$70\,mg/dL, normoglucemia 70--180\,mg/dL, hiperglucemia $>$180\,mg/dL) y grupo de edad en cada \textit {dataset} (horizonte PH\,=\,4, fold de referencia). Los porcentajes permiten comparar el desequilibrio glucémico entre grupos de edad y con la figura~\ref {fig:age_group_dist}.}}{41}{figure.caption.58}%
\contentsline {figure}{\numberline {4.14}{\ignorespaces Ratio de desequilibrio glucémico (ventanas normoglucémicas / ventanas hipoglucémicas) por grupo de edad y \textit {dataset}, expresado como mediana $\pm $ IQR entre pacientes del fold de referencia. Un ratio de 1{,}0 indicaría distribución perfectamente equilibrada entre ambas clases.}}{42}{figure.caption.59}%
\contentsline {figure}{\numberline {4.15}{\ignorespaces Ratio de desequilibrio glucémico (ventanas normoglucémicas / ventanas hipoglucémicas) por sexo y \textit {dataset}, expresado como mediana $\pm $ IQR entre pacientes del fold de referencia.}}{42}{figure.caption.60}%
\contentsline {figure}{\numberline {4.16}{\ignorespaces Distribución porcentual de ventanas de entrenamiento por clase glucémica y sexo en cada \textit {dataset}. La similitud entre grupos sugiere que el sexo no introduce desequilibrio glucémico diferencial.}}{43}{figure.caption.61}%
\contentsline {figure}{\numberline {4.17}{\ignorespaces Arquitectura del modelo LSTM.}}{55}{figure.caption.81}%
\contentsline {figure}{\numberline {4.18}{\ignorespaces Clark Error Grid de una ejecucion de LSTM para el dataset T1DiabetesGranada.}}{57}{figure.caption.83}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Tamaño medio del conjunto de entrenamiento (número de ventanas, media $\pm $ SD sobre los 5 \textit {folds}) por técnica de balanceo y \textit {dataset}, para la dimensión demográfica \textbf {edad}. La línea discontinua indica el tamaño medio del conjunto original sin balancear.}}{66}{figure.caption.94}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Tamaño medio del conjunto de entrenamiento por técnica de balanceo y \textit {dataset}, para la dimensión demográfica \textbf {sexo}. Misma escala relativa y convenciones que la figura~\ref {fig:trainsize_age}.}}{67}{figure.caption.98}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Variación $\Delta n$ y $\Delta \%$ de ventanas por técnica de balanceo y grupo de edad en \textbf {DiaTrend}. La saturación visiblemente superior refleja el desequilibrio demográfico extremo documentado en la sección~\ref {subsec:eda_demografico}.}}{69}{figure.caption.100}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Distribución glucémica del conjunto de entrenamiento de \textbf {DiaTrend} por técnica y dimensión. Las barras de ROS, SMOTE y Jittering alcanzan valores absolutos muy superiores al resto como consecuencia del ratio de desequilibrio extremo de este \textit {dataset}.}}{72}{figure.caption.103}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Variación $\Delta \%$ en la representación de rangos glucémicos para \textbf {DiaTrend}. La escala del eje es comparable a la de T1DiabetesGranada y REPLACE-BG; la magnitud de los cambios es notablemente superior en este \textit {dataset}.}}{73}{figure.caption.104}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Trade-off clínico entre la variación de hipoglucemia severa ($\Delta \%$ TBR-2, eje $X$) y la variación de normoglucemia ($\Delta \%$ TIR, eje $Y$) tras aplicar cada técnica de balanceo, por \textit {dataset}. Cada punto representa una técnica $\times $ dimensión demográfica ($\circ $\,=\,edad, $\square $\,=\,sexo). El cuadrante superior izquierdo (``ideal'') corresponde a técnicas que aumentan TIR sin incrementar la exposición a hipoglucemia severa.}}{75}{figure.caption.108}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Trade-off clínico entre la variación de hipoglucemia leve ($\Delta \%$ TBR-1, eje $X$) y la variación de normoglucemia ($\Delta \%$ TIR, eje $Y$). Mismas convenciones que la figura~\ref {fig:tradeoff_tbr2}.}}{76}{figure.caption.110}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Trade-off clínico entre la variación de hiperglucemia leve ($\Delta \%$ TAR-1, eje $X$) y la variación de normoglucemia ($\Delta \%$ TIR, eje $Y$). En este scatter el cuadrante ideal (superior izquierdo) corresponde a técnicas que aumentan TIR reduciendo simultáneamente la exposición a hiperglucemia leve.}}{77}{figure.caption.112}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Trade-off clínico entre la variación de hiperglucemia severa ($\Delta \%$ TAR-2, eje $X$) y la variación de normoglucemia ($\Delta \%$ TIR, eje $Y$). El cuadrante ideal (superior izquierdo) corresponde a técnicas que incrementan TIR reduciendo la exposición a hiperglucemia severa.}}{78}{figure.caption.114}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Distribución del RMSE sobre el conjunto completo de ventanas (\textit {ENTIRE}) por técnica de balanceo y \textit {dataset}. Cada violín resume la distribución entre los 5 \textit {folds}; la línea discontinua interior indica la mediana y las líneas externas el rango intercuartílico. La condición \textit {original} (negro) aparece como referencia.}}{79}{figure.caption.116}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Distribución del RMSE evaluado exclusivamente sobre ventanas del rango TBR-2 (hipoglucemia severa, $<$54\,mg/dL) por técnica de balanceo y \textit {dataset}. Este subconjunto es el más relevante clínicamente: un modelo con buen rendimiento global pero alto error en TBR-2 puede ser clínicamente inaceptable.}}{80}{figure.caption.118}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Consistencia del ranking de técnicas entre \textit {folds}, medida mediante la correlación de Spearman entre los rankings de RMSE (ENTIRE) de cada par de folds, por \textit {dataset}. Valores próximos a 1 indican que el mismo ranking de técnicas se reproduce en todos los folds; valores próximos a 0 o negativos indican inestabilidad: la técnica que es mejor en un fold puede ser peor en otro.}}{81}{figure.caption.120}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Variación relativa del RMSE (\textit {ENTIRE}) respecto al modelo original para cada técnica y \textit {dataset}. Valores positivos (azul) indican mejora; valores negativos (naranja) indican deterioro. Escala de color centrada en cero.}}{83}{figure.caption.123}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Variación relativa del RMSE evaluado sobre ventanas TBR-2 (hipoglucemia severa) respecto al modelo original. Compárese con la figura~\ref {fig:heatmap_delta_rmse_entire}: una técnica con celda azul en la figura anterior pero naranja en esta produce una mejora global a costa de mayor imprecisión en el rango más crítico clínicamente.}}{85}{figure.caption.125}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Posición en el ranking de cada técnica por RMSE, para cada combinación \textit {dataset} $\times $ rango glucémico (ranking 1 = menor RMSE = mejor). Las celdas verdes indican posiciones altas del ranking; las naranjas, posiciones bajas.}}{86}{figure.caption.127}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces \textit {Dumbbell chart} comparando el RMSE (\textit {ENTIRE}) del modelo original (rombo negro) frente a cada técnica balanceada (círculo de color), ordenadas de mejor a peor por \textit {dataset}. Las barras de error indican la SD inter-fold.}}{87}{figure.caption.129}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Gráfico de pendiente del RMSE (\textit {ENTIRE}) comparando el modelo original con cada técnica, separado por dimensión demográfica (edad vs.\ sexo). Una pendiente negativa indica mejora. Los tres repositorios aparecen superpuestos en cada panel; los grupos de líneas bien separados por nivel corresponden a los tres \textit {datasets}.}}{88}{figure.caption.131}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Distribución del RMSE (\textit {ENTIRE}) para la familia \textit {oversampling} (Jittering, ROS, SMOTE, ROS+Tomek). Las técnicas de esta familia incrementan el volumen del conjunto de entrenamiento respecto a la partición original.}}{90}{figure.caption.134}%
\contentsline {figure}{\numberline {5.19}{\ignorespaces Distribución del RMSE (\textit {ENTIRE}) para la familia \textit {same size} (RUS+ROS, RUS+SMOTE, SMOTE+Tomek). Estas técnicas híbridas mantienen el volumen de entrenamiento constante, actuando como grupo de control natural.}}{90}{figure.caption.135}%
\contentsline {figure}{\numberline {5.20}{\ignorespaces Distribución del RMSE (\textit {ENTIRE}) para la familia \textit {undersampling} (RUS, PA-Undersampling, Tomek Links). Las técnicas de esta familia reducen el volumen del conjunto de entrenamiento eliminando ventanas del grupo mayoritario.}}{90}{figure.caption.136}%
\contentsline {figure}{\numberline {5.21}{\ignorespaces Perfil de RMSE por rango glucémico para la familia \textit {oversampling}. Cada celda muestra el RMSE medio sobre los \textit {folds} para una combinación técnica $\times $ rango $\times $ \textit {dataset}.}}{91}{figure.caption.138}%
\contentsline {figure}{\numberline {5.22}{\ignorespaces Perfil de RMSE por rango glucémico para la familia \textit {same size}. El perfil intermedio de estas técnicas híbridas permite cuantificar en qué medida la fase de submuestreo cancela los beneficios de la fase de sobremuestreo.}}{92}{figure.caption.139}%
\contentsline {figure}{\numberline {5.23}{\ignorespaces Perfil de RMSE por rango glucémico para la familia \textit {undersampling}. Nótese la degradación en TIR y TAR frente a la mejora selectiva en TBR-2, especialmente marcada en DiaTrend.}}{92}{figure.caption.140}%
\contentsline {figure}{\numberline {5.24}{\ignorespaces Diagrama de diferencia crítica (Nemenyi) para el RMSE global en \textbf {DiaTrend} ($p < 0{,}0001$, $\chi ^2_F = 85{,}71$). Los diagramas análogos para T1DiabetesGranada y REPLACE-BG se omiten por no alcanzar significación en el test de Friedman previo ($p = 0{,}437$ y $p = 0{,}779$, respectivamente), lo que impide cualquier interpretación inferencial de los rangos medios.}}{95}{figure.caption.145}%
\contentsline {figure}{\numberline {5.25}{\ignorespaces Diagrama de diferencia crítica (Nemenyi) para el RMSE en el rango TBR-2 (hipoglucemia severa, $<$54\,mg/dL) en \textbf {DiaTrend} ($p = 0{,}00013$, $\chi ^2_F = 51{,}56$). Se omiten los diagramas de T1DiabetesGranada ($p = 0{,}120$) y REPLACE-BG ($p = 0{,}140$) por no significación del test de Friedman previo.}}{97}{figure.caption.147}%
\contentsline {figure}{\numberline {5.26}{\ignorespaces Ranking global de técnicas mediante el método Borda (suma de posiciones de ranking a través de \textit {datasets}, métricas y rangos glucémicos). Una puntuación Borda más baja indica mejor posicionamiento global. La línea discontinua vertical indica la puntuación del \textit {baseline} original en cada \textit {dataset}.}}{98}{figure.caption.149}%
\contentsline {figure}{\numberline {5.27}{\ignorespaces \textit {Bump chart} mostrando la estabilidad del ranking de cada técnica entre RMSE y MAE para el conjunto completo (\textit {ENTIRE}), por \textit {dataset}. Líneas horizontales indican estabilidad del ranking entre métricas; líneas muy inclinadas indican comportamiento dispar según la métrica.}}{98}{figure.caption.151}%
